# Copy to .env.local and fill in. Production copies of ALL of these live on
# the Vercel "ticketflow" project (Settings → Environment Variables).
# GOTCHA: paste values with no quotes and no trailing newline/whitespace —
# hidden newlines have broken deploys before.

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — required for Add/Delete Client and all email-pipeline
# server routes. NEVER expose client-side.
SUPABASE_SERVICE_ROLE_KEY=

# Email pipeline (ActivePieces ↔ shared Gmail inbox)
# Long random string; must match the Authorization: Bearer header configured
# in the ActivePieces INBOUND flow's HTTP step.
EMAIL_WEBHOOK_SECRET=
# The ActivePieces SEND flow's Catch Webhook URL.
ACTIVEPIECES_SEND_WEBHOOK_URL=
# The shared support inbox address (currently the test Gmail). Used to build
# the Reply-To routing address (support+<tag>@…) and as the own-echo guard.
SUPPORT_FROM_EMAIL=credlytest1@gmail.com

# Parked direct-Gmail OAuth feature (not needed for the live pipeline)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# CRON_SECRET=
